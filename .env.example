# ── Required ────────────────────────────────────────────────────
# Signing secret for tokens and sessions.
# MUST be the same on the server and the worker. Generate with:
#   openssl rand -base64 32
APP_SECRET=change_me_to_a_long_random_string

# Full public URL, with scheme and NO trailing slash. The frontend,
# invitation links and password resets are all built from this.
SERVER_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────
PG_USER=postgres
PG_PASSWORD=change_me_too
PG_DB=default

# ── Optional ────────────────────────────────────────────────────
# local writes attachments to the shared volume; s3 uses object storage.
STORAGE_TYPE=local

# Set to true once your workspace exists, then invite teammates in-app.
IS_SIGN_UP_DISABLED=false

# Pin a specific Twenty release instead of latest.
# TAG=latest

# Enable outbound email (invitations, password resets).
# EMAIL_DRIVER=smtp
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# SERVER_PORT=3000
